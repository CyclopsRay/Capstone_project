# Apptainer image of this project, for clusters that use Apptainer (Singularity).
# Build it on Linux from the Docker image made with containers/Dockerfile:
#   docker build --platform linux/amd64 -f containers/Dockerfile --build-arg ENV_NAME=default -t undetect:0.1.0 .
#   apptainer build containers/undetect.sif containers/apptainer.def
# Run the demo with the project folder bound:
#   apptainer exec --bind "$PWD" containers/undetect.sif snakemake --cores all
Bootstrap: docker-daemon
From: undetect:0.1.0

%runscript
    exec /entrypoint.sh "$@"

%labels
    Project undetect
