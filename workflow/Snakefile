# The demo pipeline: download -> simulate -> train and test UnDetect on 5 folds -> evaluate -> report.
#
#   pixi run reproduce       # = snakemake --cores all, from the repository root
#   pixi run dry-run         # which steps would run now, and why
#
# Settings come from config/config.yaml. Snakemake reruns a step when its
# inputs, code or settings change, and then everything that depends on it.

configfile: "config/config.yaml"

DATA = config["data"]["processed"]
RESULTS = config["results"]
FOLDS = config["model"]["folds"]
LOGS = f"{RESULTS}/logs"
SIMULATED = [f"{DATA}/{f}" for f in ("responses.npz", "compounds.tsv", "cell_painting.npz", "truth.npz",
                                     "manifest.json")]
FOLD_OUTPUTS = ["scores.csv", "settings.json", "test_predictions.npz"]
EVALUATION = [f"{RESULTS}/{f}" for f in ("scores.csv", "view_weights.csv", "summary.json")]


rule all:
    input:
        "reports/undetect-demo.html",


rule download:
    """Compound annotations from CLUE, checked against metadata/checksums.sha256 and made read-only."""
    output:
        config["data"]["compound_table"],
    log:
        f"{LOGS}/download.log",
    shell:
        "python scripts/download_data.py > {log} 2>&1"


rule simulate:
    """Real compounds, simulated responses with a known answer."""
    input:
        config["data"]["compound_table"],
    output:
        SIMULATED,
    params:
        simulation=config["simulation"],  # a changed setting reruns this step and everything after it
    log:
        f"{LOGS}/simulate.log",
    shell:
        "python scripts/simulate_data.py > {log} 2>&1"


rule train:
    """Train UnDetect on one fold and score its training, validation and test compounds."""
    input:
        SIMULATED,
    output:
        [f"{RESULTS}/folds/fold_{{fold}}/{f}" for f in FOLD_OUTPUTS],
    params:
        model=config["model"],
    threads: config["model"]["threads_per_fold"]
    log:
        f"{LOGS}/train_fold{{fold}}.log",
    shell:
        # PyTorch and the math libraries use the cores Snakemake gives the job, no more
        "OMP_NUM_THREADS={threads} MKL_NUM_THREADS={threads} OPENBLAS_NUM_THREADS={threads} "
        "python scripts/train.py --fold {wildcards.fold} > {log} 2>&1"


rule evaluate:
    """Scores of the five folds by split and stage, and the learned view weights."""
    input:
        SIMULATED,
        expand(f"{RESULTS}/folds/fold_{{fold}}/{{f}}", fold=FOLDS, f=FOLD_OUTPUTS),
    output:
        EVALUATION,
    log:
        f"{LOGS}/evaluate.log",
    shell:
        "python scripts/evaluate.py > {log} 2>&1"


rule report:
    """The Quarto report: every number, table and figure is computed from the results when it renders."""
    input:
        "reports/undetect-demo.qmd",
        EVALUATION,
        expand(f"{RESULTS}/folds/fold_{{fold}}/test_predictions.npz", fold=FOLDS),
    output:
        "reports/undetect-demo.html",
    log:
        f"{LOGS}/report.log",
    shell:
        "quarto render reports/undetect-demo.qmd > {log} 2>&1"
