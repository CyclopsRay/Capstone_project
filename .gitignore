# Pixi environments are rebuilt from pixi.lock, never committed
.pixi/*
!.pixi/config.toml

# Data are downloaded (data/raw/, read-only) or simulated (data/processed/)
data/raw/
data/processed/

# Results are regenerated by `pixi run reproduce`
results/*
!results/README.md

# Container images (attach them to a release, not to Git)
containers/*.tar.gz

# Workflow manager and test state
.snakemake/
.pytest_cache/

# Quarto and Jupyter
/.quarto/
reports/*.html
reports/*_files/
**/*.quarto_ipynb
.ipynb_checkpoints/

# Python and OS clutter
__pycache__/
*.py[cod]
.DS_Store
